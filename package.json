		"react-dom": "19.3.0",
		"server-only": "^0.0.1"
	},
	"devDependencies": {
		"@electric-sql/pglite": "^0.5.13",
		"@playwright/test": "^1.64.1",
		"@types/node": "^22",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"eslint": "^9",
		"eslint-config-next": "16.4.3",
		"eslint-config-prettier": "^10.1.8",
		"prettier": "^3.8.3",
		"typescript": "^5",
		"vitest": "^4.1.8"
	}
