{
	"name": "njt-track-predictor",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"check": "next typegen && tsc --noEmit",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"njt:capture": "node --env-file=.env scripts/capture-njt-fixture.mjs",
		"logger:export": "node --env-file-if-exists=.env scripts/export-observations.mjs"
	},
	"dependencies": {
		"@neondatabase/serverless": "^1.2.0",
		"@upstash/redis": "^1.40.0",
		"next": "16.4.3",
