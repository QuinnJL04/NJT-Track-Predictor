NJT_USERNAME=
NJT_PASSWORD=
# Optional: a token from getToken, so the app doesn't spend the 5-per-day token quota on cold starts
NJT_TOKEN=
# mock or njt
DATA_SOURCE=mock
# Optional: Postgres for training data (Neon via the Vercel Marketplace sets this). Logging is off when empty.
DATABASE_URL=
# Bearer token for /api/cron/log; generate with: openssl rand -hex 32
CRON_SECRET=
