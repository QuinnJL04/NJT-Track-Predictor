NJT_USERNAME=
NJT_PASSWORD=
# Optional: a token from getToken, so the app doesn't spend the 5-per-day token quota on cold starts
NJT_TOKEN=
# mock or njt
DATA_SOURCE=mock
# Optional: Upstash Redis, so serverless instances share the NJT token, board and daily call
# count. Leave empty for dev; the Vercel integration may set KV_REST_API_URL/TOKEN instead.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
